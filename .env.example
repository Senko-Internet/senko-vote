# Discord Bot Token (Developer Portal で取得)
DISCORD_TOKEN=your_bot_token_here

# 投票フォームが投稿されるチャンネルID
SOURCE_CHANNEL_ID=1551462058862845993

# 転送先チャンネルID
DESTINATION_CHANNEL_ID=1551462066768977970

# true にすると投票フォームのみ転送（Poll / 埋め込み / フォームURL）
# 未設定または false の場合、監視チャンネルの全メッセージを転送
FORWARD_POLL_ONLY=false
